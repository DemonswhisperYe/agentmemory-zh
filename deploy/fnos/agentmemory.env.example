# agentmemory 密钥文件（官方 ~/.agentmemory/.env，提供方识别只认这个文件）
# LLM：CPA 反代（OpenAI 兼容）
OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_LLM_KEY
OPENAI_BASE_URL=http://192.168.1.100:8317/v1
OPENAI_MODEL=agnes-3.0-flash
# 向量：Ollama 的 OpenAI 兼容 embeddings 端点（现用中文向量模型）
OPENAI_EMBEDDING_API_KEY=ollama
OPENAI_EMBEDDING_BASE_URL=http://192.168.1.100:11434/v1
OPENAI_EMBEDDING_MODEL=shaw/dmeta-embedding-zh
OPENAI_EMBEDDING_DIMENSIONS=768
AGENTMEMORY_VECTOR_BACKFILL=all
GRAPH_EXTRACTION_ENABLED=true
AGENTMEMORY_AUTO_COMPRESS=true
AGENTMEMORY_INJECT_CONTEXT=true
